// Raw colours are only allowed in tokens.css. Everywhere else, reference a token.
language css

CssDeclaration() as $d where {
  $filename <: not r".*tokens\.css",
  $d <: r"[\s\S]*#[0-9a-fA-F]{3,8}[\s\S]*|[\s\S]*rgba?\([\s\S]*|[\s\S]*hsla?\([\s\S]*|[\s\S]*oklch\([\s\S]*",
  register_diagnostic(span=$d, message="Raw colour in CSS. Define it in packages/tokens/src/tokens.css and reference the token.", severity="error")
}
