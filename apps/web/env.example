# Copy to .env.local to override. All values are optional.

# Serve /api from the in-browser mock (MSW). Default: true.
VITE_API_MOCKS=true

# When mocks are off, the dev server proxies /api here. `pnpm dev:live` sets this from $API_URL.
VITE_API_PROXY_TARGET=http://localhost:8000

# Base domain for tenant subdomains, e.g. throughline.app -> acme.throughline.app lands in /t/acme.
VITE_TENANT_BASE_DOMAIN=
